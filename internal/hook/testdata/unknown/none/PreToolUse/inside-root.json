{
  "comment": "unknown label, gate event inside a root: exit 1",
  "args": [
    "foo-agent",
    "PreToolUse"
  ],
  "env": {
    "HOME": "/u",
    "PATH": "/usr/bin:/bin",
    "PWD": "/u/work/acme"
  },
  "stdin": {
    "session_id": "00000000-0000-4000-8000-0000000000d1",
    "cwd": "/u/work/acme",
    "hook_event_name": "PreToolUse"
  },
  "daemon": {
    "gate": {
      "verdict": "allow",
      "state": "unlocked",
      "root_ids": [
        "root-acme"
      ],
      "origin": "human"
    }
  },
  "want": {
    "exit": 1,
    "stdout": "",
    "stderr": ""
  }
}
