ee1d830ca9d5498943352110cc91d6a326749ae6712695fe6f86a1f8a4ff5c80  hooks/codex.json
9fd7b5ccdefd8c2c0d6e32aa45500f9ab1cc997c2029a48e4756452d5eb41ef1  scripts/precinto-hook
