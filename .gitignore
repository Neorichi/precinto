# build output
/dist/
/bin/
/precinto
/precinto.exe
*.test
*.out
coverage.*

# local test homes / artifacts
/.tmp/
/testdata/tmp/

# never commit decrypted or sealed user data
*.pcap
*.precinto
*.age

# never commit credentials or keys (gitleaks also scans every change in CI)
.env
.env.*
.envrc
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.netrc
.npmrc

# local agent settings and notes
.claude/
CLAUDE.local.md

# local Go workspaces
go.work
go.work.sum

# editors / OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
